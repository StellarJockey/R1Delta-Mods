UnlitTwoTexture
{
	"$nocull" "1"
	"$nodecal" "1"
	"$no_fullbright" 1
	"$model" "1"
	"$nofog" "1"
	"$allowoverbright" "1"
	"$translucent" "1"

	"$basetexture" "models\weapons\reticles\bocek"
	"$Texture2" "dev\noise_post"
	"$color" "[1 1 1]"
	"$color2" "[3 1.6 0.3]"

	"$t2offset" 0
	"$t2scale" 3
	"$t2rot" 0
	"$scroll" "[0 1]"

	$holoOffset "[0 0]"

	"Proxies"
	{
		"UniformNoise"
		{
			"minVal" 0.5
			"maxVal" 1
			"resultVar" "$scroll[0]"
		}
		"UniformNoise"
		{
			"minVal" 0.5
			"maxVal" 1
			"resultVar" "$scroll[1]"
		}
		"TextureTransform"
		{
			"translateVar" "$scroll"
			"scaleVar" "$t2scale"
			"rotateVar" "$t2rot"
			"resultvar" "$texture2transform"
		}
		"UniformNoise"
		{
			"minVal" 0.8
			"maxVal" 1.00
			"resultVar" "$color"
		}
		"TextureTransform"
		{
			"translateVar" "$holoOffset"
			"resultvar" "$basetexturetransform"
		}
		"HoloSight"
		{
			resultVar $alpha
		}
		// the picture moves across the pane by as much as the eye is off its middle
		"HoloSightOffset"
		{
			attachmentName		"RETICLE"
			horizontalScalar	"0.5000"
			verticalScalar		"-0.5000"
			resultVar			$holoOffset
		}
	}
}
